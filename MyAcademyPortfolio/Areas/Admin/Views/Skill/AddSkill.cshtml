@{
	ViewData["Title"] = "AddSkill";
	Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="container-fluid px-4 py-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Yeni Yetenek Ekle</h3>
            <p class="text-muted mb-0">Yetenek kategorisi bilgilerini aşağıdaki formdan ekleyebilirsin.</p>
        </div>

        <a href="/Admin/Skill/SkillList"
           class="btn btn-light border rounded-3">
            <i class="fas fa-arrow-left me-2"></i> Geri Dön
        </a>
    </div>

    <!-- Yetenek Ekleme Kartı -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 px-4 pt-4">
            <h5 class="fw-bold mb-1">Yetenek Bilgileri</h5>
            <small class="text-muted">Lütfen gerekli alanları doldurunuz.</small>
        </div>

        <div class="card-body p-4">

            <form action="/Admin/Skill/AddSkill" method="post">

                <div class="row g-4">

                    <div class="col-12">
                        <label class="form-label fw-semibold">Yetenek Başlığı</label>
                        <input type="text"
                               name="SkillTitle"
                               class="form-control rounded-3 py-2"
                               placeholder="Örn: Backend Development" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Alt Açıklama</label>
                        <textarea name="SubTitle"
                                  class="form-control rounded-3"
                                  rows="4"
                                  placeholder="Yetenek kategorisi hakkında kısa bir açıklama yazınız..."></textarea>
                    </div>

                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Skill/SkillList"
                       class="btn btn-light border rounded-3 px-4">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn rounded-3 px-4 text-white"
                            style="background-color: #7968dc;">
                        <i class="fas fa-save me-2"></i> Yeteneği Kaydet
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>