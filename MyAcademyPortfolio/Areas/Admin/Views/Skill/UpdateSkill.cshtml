@model MyAcademyPortfolio.Entities.Skill

@{
    ViewData["Title"] = "UpdateSkill";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-header bg-white border-0 p-4">
                    <h4 class="mb-1 fw-bold">Yetenek Güncelle</h4>
                    <p class="text-muted mb-0">
                        Mevcut yetenek kategorisi bilgilerini güncelleyebilirsiniz.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form action="/Admin/Skill/UpdateSkill" method="post">

                        <input type="hidden" name="SkillId" value="@Model.SkillId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Yetenek Başlığı</label>
                            <input type="text"
                                   name="SkillTitle"
                                   class="form-control"
                                   value="@Model.SkillTitle"
                                   placeholder="Yetenek başlığını giriniz"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Alt Başlık</label>
                            <input type="text"
                                   name="SubTitle"
                                   class="form-control"
                                   value="@Model.SubTitle"
                                   placeholder="Alt başlığı giriniz"
                                   required />
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a href="/Admin/Skill/SkillList"
                               class="btn btn-light border rounded-3 px-4">
                                İptal
                            </a>

                            <button type="submit"
                                    class="btn text-white rounded-3 px-4"
                                    style="background-color: #7968dc;">
                                <i class="fas fa-save me-1"></i>
                                Değişiklikleri Kaydet
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>