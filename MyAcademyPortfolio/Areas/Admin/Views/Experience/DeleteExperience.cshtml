
@model MyAcademyPortfolio.Entities.Experience

@{
    ViewData["Title"] = "DeleteExperience";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Deneyimi Sil</h3>
            <p class="text-muted mb-0">Silmek istediğin deneyim bilgilerini kontrol et.</p>
        </div>

        <a href="/Admin/Experience/ExperienceList"
           class="btn btn-light border rounded-3">
            <i class="fas fa-arrow-left me-2"></i> Geri Dön
        </a>
    </div>

    <!-- Deneyim Silme Kartı -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 px-4 pt-4">
            <h5 class="fw-bold mb-1">Deneyim Bilgileri</h5>
            <small class="text-muted">Bu kaydı silmek istediğinden emin misin?</small>
        </div>

        <div class="card-body p-4">

            <form action="/Admin/Experience/DeleteExperience" method="post">

                <input type="hidden" name="ExperienceId" value="@Model.ExperienceId" />

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Deneyim Başlığı</label>
                        <input type="text" class="form-control rounded-3 py-2"
                               value="@Model.Title" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Şirket Adı</label>
                        <input type="text" class="form-control rounded-3 py-2"
                               value="@Model.CompanyName" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Alt Başlık</label>
                        <input type="text" class="form-control rounded-3 py-2"
                               value="@Model.SideTitle" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Çalışma Süresi</label>
                        <input type="text" class="form-control rounded-3 py-2"
                               value="@Model.Duration" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Çalışma Türü</label>
                        <input type="text" class="form-control rounded-3 py-2"
                               value="@Model.WorkType" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Aktiflik Durumu</label>
                        <input type="text" class="form-control rounded-3 py-2"
                               value="@(Model.IsActive ? "Aktif" : "Pasif")" readonly />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <textarea class="form-control rounded-3"
                                  rows="4" readonly>@Model.Description</textarea>
                    </div>

                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Experience/ExperienceList"
                       class="btn btn-light border rounded-3 px-4">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-danger rounded-3 px-4">
                        <i class="fas fa-trash me-2"></i> Deneyimi Sil
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
