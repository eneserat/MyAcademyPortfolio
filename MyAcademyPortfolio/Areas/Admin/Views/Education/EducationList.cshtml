
@model List<MyAcademyPortfolio.Entities.Education>

@{
    ViewData["Title"] = "EducationList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
@* Hocam Önce Tag Helper Kullandım Fakat Eğitim Ekle Butonunda Hata Mevcuttu..*@
<div class="container-fluid px-4 py-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">Eğitim Listesi</h3>
            <p class="text-muted mb-0">Eğitim bilgilerini buradan yönetebilirsin.</p>
        </div>

        <a href="/Admin/Education/AddEducation"
           class="btn text-white rounded-3 px-4"
           style="background-color: #7968dc;">
            <i class="fas fa-plus"></i> Yeni Eğitim Ekle
        </a>

    </div>

    <!-- Eğitim Tablosu -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 px-4 pt-4">
            <h5 class="fw-bold mb-1">Eğitim Kayıtları</h5>
            <small class="text-muted">Sistemde kayıtlı tüm eğitim bilgileri.</small>
        </div>

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Eğitim Başlığı</th>
                            <th>Alt Başlık</th>
                            <th>Eğitim Süresi</th>
                            <th>Konum</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-muted">@item.EducationId</td>

                                    <td class="fw-semibold">
                                        @item.Title
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(item.SubTitle) ? "-" : item.SubTitle)
                                    </td>

                                    <td>
                                        @item.Duration
                                    </td>

                                    <td>
                                        @item.Location
                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <a href="/Admin/Education/UpdateEducation?id=@item.EducationId"
                                               class="btn btn-sm rounded-3 text-white"
                                               style="background-color: #7968dc;"
                                               title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a href="/Admin/Education/DeleteEducation?id=@item.EducationId"
                                               class="btn btn-sm btn-danger rounded-3"
                                               title="Sil">
                                                <i class="fas fa-trash"></i>
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="fas fa-graduation-cap fa-2x text-muted mb-3"></i>
                                    <p class="text-muted mb-0">Henüz eğitim kaydı bulunmuyor.</p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
</div>
```
