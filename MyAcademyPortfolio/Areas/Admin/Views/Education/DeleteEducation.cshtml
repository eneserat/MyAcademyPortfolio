
@{
    ViewData["Title"] = "DeleteEducation";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid px-4 py-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Eğitim Sil</h3>
            <p class="text-muted mb-0">Silmek istediğin eğitim kaydını kontrol et.</p>
        </div>

        <a href="/Admin/Education/EducationList"
           class="btn btn-light border rounded-3">
            <i class="fas fa-arrow-left me-2"></i> Geri Dön
        </a>
    </div>

    <!-- Silme Kartı -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 px-4 pt-4">
            <h5 class="fw-bold mb-1">Eğitim Bilgileri</h5>
            <small class="text-muted">Silme işleminden önce bilgileri kontrol ediniz.</small>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning rounded-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Bu eğitim kaydını silmek istediğinizden emin misiniz?
                Bu işlem geri alınamaz.
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Eğitim Başlığı</label>
                    <input name="Title" value="@Model.Title" class="form-control rounded-3" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Alt Başlık</label>
                    <input name="SubTitle" value="@Model.SubTitle" class="form-control rounded-3" readonly />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Açıklama</label>
                    <textarea name="Description"
                              class="form-control rounded-3"
                              rows="4"
                              readonly>@Model.Description</textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Eğitim Süresi</label>
                    <input name="Duration" value="@Model.Duration" class="form-control rounded-3" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Konum</label>
                    <input name="Location" value="@Model.Location" class="form-control rounded-3" readonly />
                </div>

            </div>

            <hr class="my-4">

            <form action="/Admin/Education/DeleteEducation" method="post">

                <input type="hidden" name="EducationId" value="@Model.EducationId" />

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Education/EducationList"
                       class="btn btn-light border rounded-3 px-4">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-danger rounded-3 px-4">
                        <i class="fas fa-trash me-2"></i> Eğitimi Sil
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
