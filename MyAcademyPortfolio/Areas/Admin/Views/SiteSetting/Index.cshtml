@{
	ViewData["Title"] = "SiteSetting";
	Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="container-fluid px-4">

    <h1 class="mt-4">Site Ayarları</h1>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item">
            <a href="/Admin/Default/Index">Admin</a>
        </li>
        <li class="breadcrumb-item active">Site Ayarları</li>
    </ol>

    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <i class="fas fa-cog me-1"></i>
            Sosyal Medya Ayarları
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="SiteSetting"
                  asp-action="Update"
                  method="post">

                <input type="hidden" asp-for="SiteSettingId" />

                <div class="mb-4">
                    <label asp-for="InstagramUrl" class="form-label">
                        <i class="fab fa-instagram me-2"></i>Instagram URL
                    </label>
                    <input asp-for="InstagramUrl"
                           class="form-control"
                           placeholder="https://www.instagram.com/kullaniciadi" />
                </div>

                <div class="mb-4">
                    <label asp-for="LinkedInUrl" class="form-label">
                        <i class="fab fa-linkedin me-2"></i>LinkedIn URL
                    </label>
                    <input asp-for="LinkedInUrl"
                           class="form-control"
                           placeholder="https://www.linkedin.com/in/kullaniciadi" />
                </div>

                <div class="mb-4">
                    <label asp-for="GitHubUrl" class="form-label">
                        <i class="fab fa-github me-2"></i>GitHub URL
                    </label>
                    <input asp-for="GitHubUrl"
                           class="form-control"
                           placeholder="https://github.com/kullaniciadi" />
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>
