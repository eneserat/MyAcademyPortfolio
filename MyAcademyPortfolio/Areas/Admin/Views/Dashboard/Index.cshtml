@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <div class="mb-4">
        <p class="text-muted mb-0">
            Yönetim panelinize hoş geldiniz.
        </p>
    </div>

    <div class="row g-4">

        
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Toplam Proje</p>
                            <h3 class="fw-bold">@ViewBag.TotalProjects</h3>
                        </div>
                        <i class="bi bi-folder fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

     
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Toplam Yetenek</p>
                            <h3 class="fw-bold">@ViewBag.TotalSkills</h3>
                        </div>
                        <i class="bi bi-lightbulb fs-2 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Deneyimler</p>
                            <h3 class="fw-bold">@ViewBag.TotalExperiences</h3>
                        </div>
                        <i class="bi bi-briefcase fs-2 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Eğitimler -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Eğitimler</p>
                            <h3 class="fw-bold">@ViewBag.TotalEducations</h3>
                        </div>
                        <i class="bi bi-mortarboard fs-2 text-info"></i>
                    </div>
                </div>
            </div>
        </div>
      
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Toplam Mesaj</p>
                            <h3 class="fw-bold">@ViewBag.TotalMessages</h3>
                        </div>
                        <i class="bi bi-envelope fs-2 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Okunmamış Mesaj</p>
                            <h3 class="fw-bold">@ViewBag.UnreadMessages</h3>
                        </div>
                        <i class="bi bi-envelope-exclamation fs-2 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Son Gelen Mesajlar -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">Son Gelen Mesajlar</h5>
                </div>

                <div class="card-body">

                    @if (ViewBag.LatestMessages != null &&
                                        ViewBag.LatestMessages.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            Henüz mesaj bulunmuyor.
                        </p>
                    }
                    else if (ViewBag.LatestMessages != null)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>Gönderen</th>
                                        <th>Konu</th>
                                        <th>Tarih</th>
                                        <th>Durum</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in ViewBag.LatestMessages)
                                    {
                                        <tr>
                                            <td>
                                                <a href="/Admin/Message/MessageDetail/@item.MessageId"
                                                   class="text-decoration-none fw-semibold">
                                                    @item.NameSurname
                                                </a>
                                            </td>
                                            <td>@item.Subject</td>
                                            <td>
                                                @item.SendDate.ToString("dd.MM.yyyy")
                                            </td>
                                            <td>
                                                @if (item.IsRead)
                                                {
                                                    <span class="badge bg-success">
                                                        Okundu
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Okunmadı
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
</div>
